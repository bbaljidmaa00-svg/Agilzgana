{
  // Cloudflare Worker: serves ./public and answers /api/* from src/index.js.
  // DB and IMAGES have no IDs on purpose: Cloudflare creates them on the first deploy and keeps them linked.
  "name": "agilzgana",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB" }],
  "kv_namespaces": [{ "binding": "IMAGES" }],
  "observability": { "enabled": true }
}
